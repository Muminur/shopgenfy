# AI Services
GEMINI_API_KEY=
# Legacy, unused: NANO_BANANA_API_KEY — Pollinations AI generates images without an API key.

# Optional: GitHub personal access token. Raises the GitHub REST API limit
# from 60 req/hour (unauthenticated) to 5,000 req/hour when analyzing a repo
# via the GitHub Repo tab.
# GITHUB_TOKEN=

# Database
MONGODB_URI=
MONGODB_DB_NAME=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REFRESH_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_URL=

# Optional: model overrides, tried before the built-in fallback chain
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=

# Optional: base URL overrides (test seam / self-hosted proxy)
# GEMINI_API_BASE=
# POLLINATIONS_API_BASE=
# GITHUB_API_BASE=
